#!/usr/bin/env bash
#
# pre-commit - quality gate (sem Husky).
# Bloqueia o commit se o codigo nao passar no format/lint.
# Ativado via: git config core.hooksPath .githooks  (ou `make setup-hooks`)
#
set -uo pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
fail=0

echo "pre-commit: verificando formatacao/lint..."

# ---- Backend (.NET) ----
SLN=$(find backend -maxdepth 2 -name '*.sln' 2>/dev/null | head -n1)
if [ -n "$SLN" ]; then
  echo "-> backend: dotnet format --verify-no-changes ($SLN)"
  if ! dotnet format "$SLN" --verify-no-changes --verbosity quiet; then
    echo -e "${RED}x Backend fora do padrao de formatacao.${NC} Rode: ${YELLOW}make format${NC}"
    fail=1
  fi
else
  echo "-> backend: (ainda nao existe, pulando)"
fi

# ---- Frontend (React) ----
if [ -f "frontend/package.json" ]; then
  echo "-> frontend: npm run lint"
  if ! ( cd frontend && npm run --silent lint ); then
    echo -e "${RED}x Frontend com erros de lint.${NC} Rode: ${YELLOW}make format${NC}"
    fail=1
  fi
else
  echo "-> frontend: (ainda nao existe, pulando)"
fi

if [ "$fail" -ne 0 ]; then
  echo -e "${RED}Commit bloqueado pelo pre-commit.${NC}"
  exit 1
fi

echo -e "${GREEN}pre-commit OK${NC}"
exit 0
